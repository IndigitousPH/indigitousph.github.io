# Form backends (e.g. Formspree, Basin, Web3Forms) that accept POSTs.
# Set them as GitHub repository variables for the deployed site.
# When unset, each form shows contact links instead.
PUBLIC_FORM_ENDPOINT=          # contact + local network interest forms
PUBLIC_PRAYER_ENDPOINT=        # prayer requests (private inbox, prayer team only)
PUBLIC_NEWSLETTER_ENDPOINT=    # footer newsletter
