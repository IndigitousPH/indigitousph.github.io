---
import Icon from '../ui/Icon.astro';

/** FAQ accordion (deck: Accordion) built on <details>, so it needs no JavaScript. */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-3', className]}>
  {items.map((item) => (
    <details class="group rounded-tile bg-mist px-6 py-5 open:bg-brand-yellow">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
        {item.q}
        <Icon name="plus" class="transition group-open:rotate-45" />
      </summary>
      <p class="mt-3 text-ink-2">{item.a}</p>
    </details>
  ))}
</div>
