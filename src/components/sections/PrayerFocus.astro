---
import Button from '../ui/Button.astro';

/** "Praying this month" (deck: PrayerFocus). Three points edited in src/content/site/site.json. */
interface Props {
  title: string;
  points: string[];
  guideHref?: string;
  guideText?: string;
  class?: string;
}
const {
  title,
  points,
  guideHref,
  guideText = 'Download the prayer guide (PDF)',
  class: className,
} = Astro.props;
---

<div class:list={['flex flex-col gap-8', className]}>
  <h2 class="text-3xl md:text-4xl">{title}</h2>
  <ol class="grid gap-6 md:grid-cols-3">
    {points.map((point, i) => (
      <li class="flex flex-col gap-3 rounded-card bg-white p-7">
        <span class="font-mono text-3xl font-bold text-brand-orange-dark">
          {String(i + 1).padStart(2, '0')}
        </span>
        <p class="text-lg">{point}</p>
      </li>
    ))}
  </ol>
  {guideHref && (
    <Button href={guideHref} variant="ghost" icon="download" class="self-start max-w-full">
      {guideText}
    </Button>
  )}
</div>
