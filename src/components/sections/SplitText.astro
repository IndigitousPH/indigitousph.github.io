---
/**
 * Two-part block (deck: SplitText).
 * - variant="media": text with an image (or the `media` slot) on the other side. Bullets and buttons go in the default slot.
 * - variant="name": two big words with definitions and a plus sign between (About → "The name").
 */
interface Props {
  variant?: 'media' | 'name';
  eyebrow?: string;
  title?: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  mediaSide?: 'left' | 'right';
  /** For variant="name". */
  parts?: [{ word: string; text: string }, { word: string; text: string }];
  footnote?: string;
  class?: string;
}
const {
  variant = 'media',
  eyebrow,
  title,
  body,
  image,
  imageAlt = '',
  mediaSide = 'left',
  parts,
  footnote,
  class: className,
} = Astro.props;
const hasMedia = Boolean(image) || Astro.slots.has('media');
---

{variant === 'name' && parts ? (
  <div class:list={['flex flex-col gap-8', className]}>
    {title && <h2 class="text-3xl md:text-4xl">{title}</h2>}
    <div class="grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
      <div class="rounded-card bg-brand-yellow p-8 md:p-10">
        <p class="text-4xl font-bold tracking-tight md:text-5xl">{parts[0].word}</p>
        <p class="mt-3 text-lg">{parts[0].text}</p>
      </div>
      <div
        class="flex items-center justify-center font-mono text-5xl font-bold text-brand-orange-dark"
        aria-hidden="true"
      >
        +
      </div>
      <div class="rounded-card bg-ink p-8 text-white md:p-10">
        <p class="text-4xl font-bold tracking-tight text-brand-yellow md:text-5xl">
          {parts[1].word}
        </p>
        <p class="mt-3 text-lg text-white/85">{parts[1].text}</p>
      </div>
    </div>
    {footnote && <p class="max-w-3xl text-xl font-medium">{footnote}</p>}
  </div>
) : (
  <div class:list={['grid items-center gap-10', hasMedia && 'lg:grid-cols-2', className]}>
    {hasMedia && (
      <div class:list={[mediaSide === 'right' && 'lg:order-2']}>
        <slot name="media">
          <img
            src={image}
            alt={imageAlt}
            class="aspect-[4/3] w-full rounded-card object-cover"
            loading="lazy"
          />
        </slot>
      </div>
    )}
    <div class="flex max-w-2xl flex-col gap-5">
      {eyebrow && <p class="eyebrow text-brand-orange-dark">{eyebrow}</p>}
      {title && <h2 class="text-3xl md:text-4xl">{title}</h2>}
      {body && <p class="text-lg leading-relaxed text-ink-2">{body}</p>}
      <slot />
    </div>
  </div>
)}
