---
/**
 * Home hero (deck block 1). Full-width photo with a dark overlay, left-aligned text,
 * two buttons in the `actions` slot. Without a photo it shows a brand collage instead.
 */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Real event photo (under /public). Landscape, 2000px+ wide. */
  image?: string;
  imageAlt?: string;
  class?: string;
}
const { eyebrow, title, intro, image, imageAlt = '', class: className } = Astro.props;
---

<section class:list={['relative isolate overflow-hidden bg-ink text-white', className]}>
  {image ? (
    <>
      <img
        src={image}
        alt={imageAlt}
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/80 to-ink/30"
        aria-hidden="true"
      />
    </>
  ) : (
    <div
      class="pointer-events-none absolute -top-40 -right-40 -z-10 h-[32rem] w-[32rem] rounded-full bg-brand-gradient-soft opacity-60 blur-3xl"
      aria-hidden="true"
    />
  )}
  <div
    class:list={[
      'container-page grid items-center gap-12 py-20 md:py-28',
      !image && 'lg:grid-cols-[1.2fr_1fr]',
    ]}
  >
    <div class="flex max-w-2xl flex-col gap-6">
      {eyebrow && <p class="eyebrow text-brand-yellow">{eyebrow}</p>}
      <h1 class="text-4xl leading-[1.1] sm:text-5xl lg:text-6xl">{title}</h1>
      {intro && <p class="text-lg text-white/85 md:text-xl">{intro}</p>}
      <div class="flex flex-wrap gap-3 pt-2">
        <slot name="actions" />
      </div>
    </div>
    {!image && (
      <div class="hidden lg:block" aria-hidden="true">
        <div class="grid grid-cols-2 gap-4 font-mono">
          <div class="flex aspect-square flex-col justify-end rounded-card bg-brand-gradient p-6 text-ink">
            <span class="text-2xl font-bold">Gather</span>
          </div>
          <div class="mt-10 flex aspect-square flex-col justify-end rounded-card bg-brand-yellow p-6 text-ink">
            <span class="text-2xl font-bold">Create</span>
          </div>
          <div class="-mt-10 flex aspect-square flex-col justify-end rounded-card bg-ink-2 p-6 text-brand-yellow ring-1 ring-white/10">
            <span class="text-2xl font-bold">Pray</span>
          </div>
          <div class="flex aspect-square flex-col justify-end rounded-card bg-white p-6 text-ink">
            <span class="text-2xl font-bold">Serve</span>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
