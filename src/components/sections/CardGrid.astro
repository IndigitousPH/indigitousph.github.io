---
/** Responsive grid for cards. */
interface Props {
  cols?: 2 | 3 | 4;
  class?: string;
}
const { cols = 3, class: className } = Astro.props;
const colClasses = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<div class:list={['grid grid-cols-1 gap-6 md:gap-8', colClasses[cols], className]}>
  <slot />
</div>
