---
import Icon, { type IconName } from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

/** "Every gift has a place" (deck block 5): heading, body, six tiles, one link. */
interface Props {
  title: string;
  body?: string;
  tiles: { label: string; icon: IconName }[];
  linkText?: string;
  href?: string;
  class?: string;
}
const { title, body, tiles, linkText, href, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-8', className]}>
  <div class="flex max-w-2xl flex-col gap-3">
    <h2 class="text-3xl md:text-4xl">{title}</h2>
    {body && <p class="text-lg text-ink-2">{body}</p>}
  </div>
  <ul class="grid grid-cols-2 gap-3 md:grid-cols-3">
    {tiles.map((tile, i) => (
      <li
        class:list={[
          'flex items-center gap-3 rounded-pill px-5 py-4 font-medium',
          i % 2 ? 'bg-white ring-1 ring-stone' : 'bg-brand-yellow',
        ]}
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-brand-yellow">
          <Icon name={tile.icon} size={18} />
        </span>
        <span class="leading-tight">{tile.label}</span>
      </li>
    ))}
  </ul>
  {href && linkText && (
    <Button href={href} variant="ghost" icon="arrow-right" class="self-start max-w-full">
      {linkText}
    </Button>
  )}
</div>
