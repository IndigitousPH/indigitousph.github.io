---
/** Vertical-rhythm wrapper. Every page section should use this for consistent spacing. */
interface Props {
  tone?: 'white' | 'mist' | 'ink';
  id?: string;
  class?: string;
}
const { tone = 'white', id, class: className } = Astro.props;
const tones = { white: 'bg-white', mist: 'bg-mist', ink: 'bg-ink text-white' };
---

<section {id} class:list={['py-16 md:py-24', tones[tone], className]}>
  <div class="container-page">
    <slot />
  </div>
</section>
