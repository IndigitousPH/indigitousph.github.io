---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Placeholder from '../ui/Placeholder.astro';

/**
 * Wide "Coming up" card (deck block 4): event art left, details right.
 * Pages pass the next featured event; render nothing when there is none.
 * Hides itself in the browser once `endDate` has passed (see BaseLayout).
 */
interface Props {
  label?: string;
  title: string;
  details: string;
  body?: string;
  href?: string;
  cta?: string;
  image?: string;
  endDate: Date;
  class?: string;
}
const {
  label = 'Coming up',
  title,
  details,
  body,
  href,
  cta = 'Register now',
  image,
  endDate,
  class: className,
} = Astro.props;
---

<article
  class:list={[
    'grid overflow-hidden rounded-card bg-white ring-1 ring-stone md:grid-cols-[2fr_3fr]',
    className,
  ]}
  data-hide-after={endDate.toISOString()}
>
  {image ? (
    <img
      src={image}
      alt=""
      class="aspect-video h-full w-full object-cover md:aspect-auto"
      loading="lazy"
    />
  ) : (
    <Placeholder icon="sparkles" class="aspect-video h-full w-full md:aspect-auto" />
  )}
  <div class="flex flex-col gap-4 p-7 md:p-10">
    <p class="eyebrow text-brand-orange-dark">{label}</p>
    <h3 class="text-2xl md:text-3xl">{title}</h3>
    <p class="flex items-start gap-2 font-mono text-sm text-ink-2">
      <Icon name="calendar" size={18} class="mt-0.5" />
      {details}
    </p>
    {body && <p class="text-lg text-ink-2">{body}</p>}
    {href && (
      <Button href={href} external icon="arrow-up-right" class="mt-2 self-start max-w-full">
        {cta}
      </Button>
    )}
  </div>
</article>
