---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { mainNav } from '@/config/site';
import { t } from '@/i18n';

/**
 * Sticky header (deck: Header.astro). Logo left, nav centre, "Partner with us" right.
 * Below 1024px the nav collapses into a full-screen drawer.
 */
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-stone/60 bg-white/95 backdrop-blur">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-pill focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
  >
    {t('nav.skip')}
  </a>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" aria-label={t('site.name')}>
      <Logo size="sm" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-pill px-3 py-2 text-[0.95rem] font-medium transition-colors hover:bg-mist',
                isActive(item.href) && 'bg-mist text-brand-orange-dark',
              ]}
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <Button href="/partner" size="sm">
          {t('nav.partnerCta')}
        </Button>
      </div>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-mist lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">{t('nav.menu')}</span>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden flex-col bg-ink text-white lg:hidden"
  data-menu
  role="dialog"
  aria-modal="true"
  aria-label={t('nav.menu')}
>
  <div class="container-page flex h-18 shrink-0 items-center justify-between">
    <a href="/" aria-label={t('site.name')}>
      <Logo size="sm" tone="light" />
    </a>
    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-white/10"
      data-menu-close
    >
      <span class="sr-only">{t('nav.close')}</span>
      <Icon name="close" />
    </button>
  </div>
  <nav
    aria-label="Main"
    class="container-page flex flex-1 flex-col justify-between overflow-y-auto pt-6 pb-10"
  >
    <ul class="flex flex-col gap-1">
      {mainNav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block py-2 text-3xl font-bold',
              isActive(item.href) ? 'text-brand-yellow' : 'hover:text-brand-yellow',
            ]}
          >
            {t(item.key)}
          </a>
        </li>
      ))}
    </ul>
    <Button href="/partner" variant="light" size="lg" fullWidth class="mt-8">
      {t('nav.partnerCta')}
    </Button>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const close = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? close : toggle)?.focus();
  };
  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener(
    'keydown',
    (e) => e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true' && setOpen(false),
  );
</script>
