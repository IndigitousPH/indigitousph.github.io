---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { mainNav } from '@/config/site';
import {
  languages,
  localizePath,
  stripLang,
  switchLangPath,
  useTranslations,
  type Lang,
} from '@/i18n';

/** Sticky site header with desktop nav, mobile menu and language switcher. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
const otherLang: Lang = lang === 'en' ? 'fil' : 'en';
---

<header class="sticky top-0 z-50 border-b border-stone/60 bg-white/90 backdrop-blur">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded-pill focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
  >
    {t('nav.skip')}
  </a>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href={localizePath('/', lang)} aria-label={t('site.name')}>
      <Logo size="sm" />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={localizePath(item.href, lang)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-pill px-3 py-2 text-[0.95rem] font-medium transition-colors hover:bg-mist',
                isActive(item.href) && 'bg-mist text-brand-orange-dark',
              ]}
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchLangPath(Astro.url.pathname, otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        class="inline-flex items-center gap-1.5 rounded-pill px-3 py-2 font-mono text-sm font-medium hover:bg-mist"
        aria-label={`${t('nav.language')}: ${languages[otherLang]}`}
      >
        <Icon name="globe" size={16} />
        {otherLang === 'fil' ? 'FIL' : 'EN'}
      </a>
      <div class="hidden sm:block">
        <Button href={localizePath('/start-here', lang)} size="sm">
          {t('nav.startHere')}
        </Button>
      </div>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-mist xl:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">{t('nav.menu')}</span>
        <span data-icon-open>
          <Icon name="menu" />
        </span>
        <span class="hidden" data-icon-close>
          <Icon name="close" />
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Main"
    class="hidden border-t border-stone/60 bg-white xl:hidden"
    data-menu
  >
    <ul class="container-page flex flex-col py-4">
      {mainNav.map((item) => (
        <li>
          <a
            href={localizePath(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block rounded-tile px-4 py-3 text-lg font-medium hover:bg-mist',
              isActive(item.href) && 'text-brand-orange-dark',
            ]}
          >
            {t(item.key)}
          </a>
        </li>
      ))}
      <li class="px-4 pt-4">
        <Button href={localizePath('/start-here', lang)} fullWidth>
          {t('nav.startHere')}
        </Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  });
</script>
