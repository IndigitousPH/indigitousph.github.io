---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { footerNav, site } from '@/config/site';
import { localizePath, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="flex max-w-sm flex-col gap-5">
      <Logo tone="light" />
      <p class="text-white/75">{t('footer.about')}</p>
      <ul class="flex gap-2">
        {site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-brand-orange-dark"
            >
              <Icon name={s.icon} label={s.label} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label={t('footer.explore')}>
      <h2 class="eyebrow mb-4 text-brand-yellow">{t('footer.explore')}</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 md:grid-cols-1">
        {footerNav.map((item) => (
          <li>
            <a href={localizePath(item.href, lang)} class="text-white/85 hover:text-brand-yellow">
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow mb-4 text-brand-yellow">{t('footer.global')}</h2>
      <ul class="flex flex-col gap-2.5">
        <li>
          <a href={site.global.home} class="text-white/85 hover:text-brand-yellow">
            indigitous.org
          </a>
        </li>
        <li>
          <a href={site.global.hack} class="text-white/85 hover:text-brand-yellow">
            #HACK
          </a>
        </li>
        <li>
          <a href={site.global.learn} class="text-white/85 hover:text-brand-yellow">
            Learn
          </a>
        </li>
        <li>
          <a href={site.global.statementOfFaith} class="text-white/85 hover:text-brand-yellow">
            {t('footer.faith')}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 font-mono text-sm text-white/60 sm:flex-row sm:justify-between">
      <p>
        © {year} Indigitous Philippines. {t('footer.rights')}
      </p>
      <a href={site.global.privacy} class="hover:text-brand-yellow">
        {t('footer.privacy')}
      </a>
    </div>
  </div>
</footer>
