---
/** Brand-gradient stand-in for missing photos. Shows a large initial or icon. */
import Icon, { type IconName } from './Icon.astro';
interface Props {
  label?: string;
  icon?: IconName;
  tone?: 'gradient' | 'ink' | 'yellow';
  class?: string;
}
const { label = '', icon, tone = 'gradient', class: className } = Astro.props;
const tones = {
  gradient: 'bg-brand-gradient-soft text-ink',
  ink: 'bg-ink-2 text-brand-yellow',
  yellow: 'bg-brand-yellow text-ink',
};
---

<div
  class:list={['relative flex items-center justify-center overflow-hidden', tones[tone], className]}
  aria-hidden="true"
>
  <div
    class="absolute inset-0 opacity-15"
    style="background-image: radial-gradient(currentColor 1.5px, transparent 1.5px); background-size: 16px 16px;"
  ></div>
  {icon ? (
    <Icon name={icon} size={56} class="relative" />
  ) : (
    <span class="relative font-mono text-6xl font-bold">{label.slice(0, 1)}</span>
  )}
</div>
