---
import PillTag from '../ui/PillTag.astro';
import Placeholder from '../ui/Placeholder.astro';

/** Team member (deck: TeamGrid card): round photo, name, role, one-line "I serve because…". */
interface Props {
  name: string;
  role: string;
  serveBecause?: string;
  photo?: string;
  placeholder?: boolean;
  class?: string;
}
const { name, role, serveBecause, photo, placeholder = false, class: className } = Astro.props;
---

<article class:list={['flex flex-col items-center gap-3 text-center', className]}>
  {photo ? (
    <img src={photo} alt={name} class="h-36 w-36 rounded-full object-cover" loading="lazy" />
  ) : (
    <Placeholder label={name} tone="yellow" class="h-36 w-36 rounded-full" />
  )}
  <h3 class="mt-2 text-xl">{name}</h3>
  <PillTag size="sm">{role}</PillTag>
  {serveBecause && <p class="max-w-xs text-ink-2 italic">“{serveBecause}”</p>}
  {placeholder && (
    <PillTag tone="outline" size="sm">
      Sample content
    </PillTag>
  )}
</article>
