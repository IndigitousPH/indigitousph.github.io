---
import Placeholder from '../ui/Placeholder.astro';

/** Pull quote with portrait and attribution. */
interface Props {
  quote: string;
  name: string;
  role?: string;
  photo?: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const { quote, name, role, photo, tone = 'light', class: className } = Astro.props;
---

<figure
  class:list={[
    'flex h-full flex-col gap-6 rounded-card p-8',
    tone === 'light' ? 'bg-mist text-ink' : 'bg-ink-2 text-white',
    className,
  ]}
>
  <span class="font-mono text-6xl leading-none text-brand-orange" aria-hidden="true">
    “
  </span>
  <blockquote class="-mt-6 text-xl leading-relaxed font-medium">{quote}</blockquote>
  <figcaption class="mt-auto flex items-center gap-4">
    {photo ? (
      <img src={photo} alt="" class="h-14 w-14 rounded-full object-cover" loading="lazy" />
    ) : (
      <Placeholder label={name} tone="yellow" class="h-14 w-14 rounded-full [&_span]:text-xl" />
    )}
    <span class="flex flex-col">
      <span class="font-bold">{name}</span>
      {role && (
        <span class:list={['font-mono text-sm', tone === 'light' ? 'text-muted' : 'text-white/70']}>
          {role}
        </span>
      )}
    </span>
  </figcaption>
</figure>
