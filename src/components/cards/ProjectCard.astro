---
import PillTag from '../ui/PillTag.astro';
import Icon from '../ui/Icon.astro';

/** Project tile with type tag and status. */
interface Props {
  title: string;
  href: string;
  summary: string;
  type: string;
  status?: string;
  year?: number;
  placeholder?: boolean;
  placeholderLabel?: string;
  class?: string;
}
const {
  title,
  href,
  summary,
  type,
  status,
  year,
  placeholder = false,
  placeholderLabel = 'Sample content',
  class: className,
} = Astro.props;
---

<article
  class:list={[
    'group relative flex h-full flex-col gap-4 rounded-card bg-mist p-7 transition hover:bg-brand-yellow',
    className,
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    <PillTag tone="ink" size="sm">
      {type}
    </PillTag>
    {status && (
      <PillTag tone="outline" size="sm">
        {status}
      </PillTag>
    )}
    {placeholder && (
      <PillTag tone="outline" size="sm">
        {placeholderLabel}
      </PillTag>
    )}
  </div>
  <h3 class="text-2xl leading-snug">
    <a href={href} class="after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="text-ink-2">{summary}</p>
  <div class="mt-auto flex items-center justify-between pt-2 font-mono text-sm">
    <span>{year}</span>
    <Icon
      name="arrow-up-right"
      class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </div>
</article>
