---
import FormShell from './FormShell.astro';
import Field from '../ui/Field.astro';
import Choices from '../ui/Choices.astro';
import { forms } from '@/config/site';

/** "Let's get you connected" (deck: InterestForm) on /networks. */
interface Props {
  endpoint?: string;
  class?: string;
}
const { endpoint = forms.general, class: className } = Astro.props;
---

<FormShell
  endpoint={endpoint}
  formName="network-interest"
  submitLabel="Connect me"
  success="Salamat! Someone from the team will reach out within 3 days."
  class={className}
>
  <div class="grid gap-5 sm:grid-cols-2">
    <Field label="Name" name="name" required />
    <Field label="Email" name="email" type="email" required />
    <Field label="City or province" name="city" required />
    <Field label="Church (optional)" name="church" />
  </div>
  <Choices
    legend="How would you like to serve?"
    name="serve"
    options={[
      'Design',
      'Writing',
      'Video & photo',
      'Development',
      'Organizing',
      'Prayer',
      'Not sure yet',
    ]}
  />
  <Field label="Message (optional)" name="message" as="textarea" />
</FormShell>
