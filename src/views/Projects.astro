---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import CardGrid from '@/components/sections/CardGrid.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import SwitchTabs from '@/components/ui/SwitchTabs.astro';
import Button from '@/components/ui/Button.astro';
import { projectTypes } from '@/content.config';
import { localizePath, pick, useTranslations, type Lang } from '@/i18n';
import { getLocalized } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = pick(
  {
    en: {
      title: 'Built by Filipinos, for the mission',
      intro: 'Apps, websites, content and research from #HACK teams and Indigitous PH volunteers.',
      types: { app: 'App', web: 'Web', content: 'Content', game: 'Game', research: 'Research' },
      status: { idea: 'Idea', building: 'Building', live: 'Live' },
      ctaTitle: 'Have a project idea?',
      ctaBody: 'Bring it to #HACK or tell us about it. We can help find a team.',
    },
    fil: {
      title: 'Gawa ng Pilipino, para sa misyon',
      intro:
        'Mga app, website, content at research mula sa mga #HACK team at volunteer ng Indigitous PH.',
      types: { app: 'App', web: 'Web', content: 'Content', game: 'Laro', research: 'Research' },
      status: { idea: 'Ideya', building: 'Ginagawa', live: 'Live' },
      ctaTitle: 'May ideya ka bang proyekto?',
      ctaBody: 'Dalhin ito sa #HACK o sabihin sa amin. Matutulungan ka naming makahanap ng team.',
    },
  },
  lang,
);
const projects = (await getLocalized('projects', lang)).sort((a, b) => b.data.year - a.data.year);
const usedTypes = projectTypes.filter((type) => projects.some((p) => p.data.type === type));
---

<BaseLayout {lang} title={t('nav.projects')} description={copy.intro}>
  <PageHeader eyebrow={t('nav.projects')} title={copy.title} intro={copy.intro} />
  <Section>
    <SwitchTabs
      filterGroup="projects"
      active="all"
      label={t('nav.projects')}
      class="mb-10"
      items={[
        { label: t('filter.all'), value: 'all' },
        ...usedTypes.map((type) => ({ label: copy.types[type], value: type })),
      ]}
    />
    <CardGrid>
      {projects.map((p) => (
        <div data-filter-group="projects" data-filter-tags={p.data.type}>
          <ProjectCard
            title={p.data.title}
            href={localizePath(`/projects/${p.slug}`, lang)}
            summary={p.data.summary}
            type={copy.types[p.data.type]}
            status={copy.status[p.data.status]}
            year={p.data.year}
            placeholder={p.data.placeholder}
            placeholderLabel={t('label.placeholder')}
          />
        </div>
      ))}
    </CardGrid>
  </Section>
  <Section class="pt-0!">
    <CtaBand title={copy.ctaTitle} body={copy.ctaBody}>
      <Button href={localizePath('/hack', lang)} variant="dark">
        #HACK
      </Button>
      <Button href={localizePath('/contact', lang)} variant="light" icon="arrow-right">
        {t('nav.contact')}
      </Button>
    </CtaBand>
  </Section>
</BaseLayout>
