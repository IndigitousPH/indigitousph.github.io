---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import CardGrid from '@/components/sections/CardGrid.astro';
import TestimonialCard from '@/components/cards/TestimonialCard.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { localizePath, pick, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const copy = pick(
  {
    en: {
      title: 'Indigenous + digital',
      intro:
        'Indigitous is a global network helping followers of Jesus take the gospel to new people, places and spaces. Indigitous Philippines is its local expression here at home.',
      missionLabel: 'Our mission',
      mission: 'To help followers of Jesus take the gospel to new people, places and spaces.',
      visionLabel: 'Our vision',
      vision: 'Followers of Jesus discovering their place in God’s mission.',
      storyEyebrow: 'Our story',
      storyTitle: 'Why the Philippines',
      story: [
        'Since 2013, Indigitous has gathered developers, designers, creatives and ministry leaders around the world. Through #HACK, local communities and digital projects, thousands have discovered that their skills can serve God’s mission.',
        'Filipinos are among the most connected people on earth, and our churches and campuses are full of gifted tech and creative people. Indigitous communities have met in Manila and Iloilo, and this site is where we bring that work together for the whole country.',
        'We are part of the global Indigitous network and partner with Cru (Philippine Campus Crusade for Christ).',
      ],
      voicesEyebrow: 'Voices',
      voicesTitle: 'What people say',
      quotes: [
        {
          quote:
            'I never thought my coding could be used for ministry. #HACK changed how I see my work.',
          name: 'First-time hacker',
          role: '#HACK Manila (sample quote)',
        },
        {
          quote:
            'Indigitous helped me see my design work as part of God’s mission, not separate from it.',
          name: 'Designer',
          role: 'Iloilo (sample quote)',
        },
      ],
      globalCta: 'Indigitous global',
      faithCta: 'Statement of faith',
      teamCta: 'Meet the team',
      ctaTitle: 'Discover your place in God’s mission',
      ctaBody: 'Whatever your skill, there is a place for you.',
    },
    fil: {
      title: 'Indigenous + digital',
      intro:
        'Ang Indigitous ay pandaigdigang network na tumutulong sa mga tagasunod ni Hesus na dalhin ang ebanghelyo sa mga bagong tao, lugar at espasyo. Ang Indigitous Philippines ang lokal na bahagi nito rito sa ating bayan.',
      missionLabel: 'Ang aming misyon',
      mission:
        'Tulungan ang mga tagasunod ni Hesus na dalhin ang ebanghelyo sa mga bagong tao, lugar at espasyo.',
      visionLabel: 'Ang aming bisyon',
      vision: 'Mga tagasunod ni Hesus na tumutuklas ng kanilang lugar sa misyon ng Diyos.',
      storyEyebrow: 'Ang aming kuwento',
      storyTitle: 'Bakit ang Pilipinas',
      story: [
        'Mula 2013, tinitipon ng Indigitous ang mga developer, designer, creative at lider ng ministeryo sa buong mundo. Sa pamamagitan ng #HACK, mga lokal na komunidad at digital na proyekto, libu-libo ang nakatuklas na magagamit ang kanilang galing sa misyon ng Diyos.',
        'Isa ang mga Pilipino sa pinaka-konektadong tao sa mundo, at puno ang ating mga simbahan at kampus ng mga mahuhusay na tech at creative. May mga komunidad ng Indigitous sa Manila at Iloilo, at dito namin pinagsasama ang gawaing iyon para sa buong bansa.',
        'Bahagi kami ng pandaigdigang Indigitous network at katuwang ang Cru (Philippine Campus Crusade for Christ).',
      ],
      voicesEyebrow: 'Mga boses',
      voicesTitle: 'Sabi nila',
      quotes: [
        {
          quote:
            'Hindi ko akalaing magagamit ang coding ko sa ministeryo. Binago ng #HACK ang pagtingin ko sa trabaho ko.',
          name: 'Unang beses na hacker',
          role: '#HACK Manila (halimbawa)',
        },
        {
          quote:
            'Tinulungan ako ng Indigitous na makita ang design work ko bilang bahagi ng misyon ng Diyos.',
          name: 'Designer',
          role: 'Iloilo (halimbawa)',
        },
      ],
      globalCta: 'Indigitous global',
      faithCta: 'Pahayag ng pananampalataya',
      teamCta: 'Kilalanin ang koponan',
      ctaTitle: 'Tuklasin ang iyong lugar sa misyon ng Diyos',
      ctaBody: 'Anuman ang iyong galing, may lugar para sa iyo.',
    },
  },
  lang,
);
---

<BaseLayout {lang} title={t('nav.about')} description={copy.intro}>
  <PageHeader eyebrow={t('nav.about')} title={copy.title} intro={copy.intro}>
    <Button href={L('/about/team')} icon="arrow-right">
      {copy.teamCta}
    </Button>
    <Button href={site.global.about} variant="outline" external icon="arrow-up-right">
      {copy.globalCta}
    </Button>
  </PageHeader>

  <Section>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-card bg-brand-yellow p-8 md:p-12">
        <p class="eyebrow mb-4">{copy.missionLabel}</p>
        <p class="text-2xl leading-snug font-bold md:text-3xl">{copy.mission}</p>
      </div>
      <div class="rounded-card bg-ink p-8 text-white md:p-12">
        <p class="eyebrow mb-4 text-brand-yellow">{copy.visionLabel}</p>
        <p class="text-2xl leading-snug font-bold md:text-3xl">{copy.vision}</p>
      </div>
    </div>
  </Section>

  <Section tone="mist">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <SectionHeading eyebrow={copy.storyEyebrow} title={copy.storyTitle} class="mb-0" />
      <div class="flex flex-col gap-5 text-lg text-ink-2">
        {copy.story.map((p) => (
          <p>{p}</p>
        ))}
        <div class="flex flex-wrap gap-3 pt-2">
          <Button
            href={site.global.statementOfFaith}
            variant="outline"
            size="sm"
            external
            icon="arrow-up-right"
          >
            {copy.faithCta}
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow={copy.voicesEyebrow} title={copy.voicesTitle} />
    <CardGrid cols={2}>
      {copy.quotes.map((q, i) => (
        <TestimonialCard {...q} tone={i % 2 ? 'dark' : 'light'} />
      ))}
    </CardGrid>
  </Section>

  <Section class="pt-0!">
    <CtaBand title={copy.ctaTitle} body={copy.ctaBody}>
      <Button href={L('/start-here')} variant="dark" icon="arrow-right">
        {t('nav.startHere')}
      </Button>
    </CtaBand>
  </Section>
</BaseLayout>
