---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import CardGrid from '@/components/sections/CardGrid.astro';
import EventCard from '@/components/cards/EventCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PillTag from '@/components/ui/PillTag.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import { render } from 'astro:content';
import { htmlLang, localizePath, pick, useTranslations, type Lang } from '@/i18n';
import { byDateAsc, getLocalized, type Localized } from '@/lib/content';

interface Props {
  lang: Lang;
  entry: Localized<'communities'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
const copy = pick(
  {
    en: { events: 'Events', meets: 'When we meet', join: 'Get in touch' },
    fil: { events: 'Mga event', meets: 'Kailan kami nagkikita', join: 'Makipag-ugnayan' },
  },
  lang,
);
const cityEvents = (await getLocalized('events', lang))
  .filter(
    (e) =>
      e.data.location.toLowerCase().includes(d.name.toLowerCase()) ||
      e.data.tags.includes(entry.slug),
  )
  .sort(byDateAsc);
---

<BaseLayout {lang} title={`${d.name} · ${t('label.community')}`} description={d.summary}>
  <header class="bg-mist">
    <div class="container-page grid items-center gap-10 py-14 md:py-20 lg:grid-cols-2">
      <div class="flex flex-col gap-5">
        <a
          href={localizePath('/communities', lang)}
          class="inline-flex w-max items-center gap-2 font-mono text-sm text-muted hover:text-brand-orange-dark"
        >
          <Icon name="arrow-left" size={16} />
          {t('nav.communities')}
        </a>
        <p class="eyebrow flex items-center gap-1.5 text-brand-orange-dark">
          <Icon name="map-pin" size={14} />
          {d.region}
        </p>
        <h1 class="text-5xl md:text-6xl">{d.name}</h1>
        <p class="text-lg text-ink-2">{d.summary}</p>
        {d.placeholder && (
          <PillTag tone="outline" size="sm">
            {t('label.placeholder')}
          </PillTag>
        )}
        <Button
          href={d.contactUrl ?? localizePath('/contact', lang)}
          icon="arrow-right"
          class="w-max"
        >
          {copy.join}
        </Button>
      </div>
      {d.image ? (
        <img src={d.image} alt="" class="aspect-[4/3] w-full rounded-card object-cover" />
      ) : (
        <Placeholder label={d.name} class="aspect-[4/3] w-full rounded-card" />
      )}
    </div>
  </header>
  <Section>
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="prose-indigitous">
        <Content />
      </div>
      {d.meets && (
        <aside class="h-max rounded-card bg-brand-yellow p-8">
          <p class="eyebrow mb-2">{copy.meets}</p>
          <p class="text-xl font-bold">{d.meets}</p>
        </aside>
      )}
    </div>
  </Section>
  {cityEvents.length > 0 && (
    <Section tone="mist">
      <SectionHeading title={copy.events} />
      <CardGrid>
        {cityEvents.map((e) => (
          <EventCard
            title={e.data.title}
            href={localizePath(`/events/${e.slug}`, lang)}
            date={e.data.date}
            location={e.data.location}
            online={e.data.online}
            placeholder={e.data.placeholder}
            lang={htmlLang[lang]}
            labels={{
              event: t('label.event'),
              online: t('events.online'),
              placeholder: t('label.placeholder'),
            }}
          />
        ))}
      </CardGrid>
    </Section>
  )}
</BaseLayout>
