---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import CardGrid from '@/components/sections/CardGrid.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import NewsletterBand from '@/components/sections/NewsletterBand.astro';
import FeatureGrid, { type FeatureItem } from '@/components/sections/FeatureGrid.astro';
import Button from '@/components/ui/Button.astro';
import EventCard from '@/components/cards/EventCard.astro';
import StoryCard from '@/components/cards/StoryCard.astro';
import CommunityCard from '@/components/cards/CommunityCard.astro';
import { htmlLang, localizePath, pick, useTranslations, type Lang } from '@/i18n';
import { byDateAsc, byDateDesc, byOrder, getLocalized, isUpcoming } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const copy = pick(
  {
    en: {
      eyebrow: 'Indigitous Philippines',
      title: 'Helping Filipinos reach their world',
      highlight: 'reach their world',
      intro:
        'We are developers, designers, storytellers and ministry leaders using tech and creativity to take the gospel to new people, places and spaces across the Philippines.',
      hackCta: 'Join #HACK',
      programsEyebrow: 'What we do',
      programsTitle: 'Indigenous + digital',
      programsIntro:
        'Indigitous is a global network of followers of Jesus discovering their place in God’s mission. Here’s how we do it in the Philippines.',
      programs: [
        {
          icon: 'code',
          title: '#HACK Philippines',
          body: 'Every October, teams across the country build practical solutions to close missional gaps.',
          href: '/hack',
          cta: 'About #HACK',
        },
        {
          icon: 'users',
          title: 'Local communities',
          body: 'Regular meetups in Manila and Iloilo for tech and creative people to learn, build and pray.',
          href: '/communities',
          cta: 'Find a community',
        },
        {
          icon: 'sparkles',
          title: 'Projects',
          body: 'Apps, websites and content made by Filipinos, for Filipinos, and for the church.',
          href: '/projects',
          cta: 'See projects',
        },
      ],
      eventsEyebrow: 'Our events',
      eventsTitle: 'What’s coming up',
      statsCaption: 'Global #HACK numbers since 2016, from hack.indigitous.org.',
      stats: [
        { value: '10,154', label: 'people have joined #HACK' },
        { value: '174', label: 'cities worldwide' },
        { value: '63', label: 'countries' },
        { value: '2', label: 'communities in the Philippines' },
      ],
      needEyebrow: 'Why it matters',
      needTitle: 'Today, 3 billion people don’t know Jesus',
      needBody:
        'Many of them are online, and so are more than 85 million Filipinos. The digital world is a mission field, and you have a place in it.',
      needCta: 'About Indigitous',
      communityEyebrow: 'Our community',
      communityTitle: 'Find your people',
      startCommunity: 'Start a community',
      tribeTitle: 'Are you a creative or developer?',
      tribeBody:
        'Find your tribe here. Use your skills to serve the church and reach people with the gospel.',
      tribeCta: 'Get involved',
      storiesEyebrow: 'Stories',
      storiesTitle: 'Latest from Indigitous PH',
    },
    fil: {
      eyebrow: 'Indigitous Philippines',
      title: 'Tinutulungan ang mga Pilipino na abutin ang kanilang mundo',
      highlight: 'abutin ang kanilang mundo',
      intro:
        'Kami ay mga developer, designer, storyteller at lider ng ministeryo na gumagamit ng teknolohiya at pagkamalikhain para dalhin ang ebanghelyo sa mga bagong tao, lugar at espasyo sa buong Pilipinas.',
      hackCta: 'Sumali sa #HACK',
      programsEyebrow: 'Ang ginagawa namin',
      programsTitle: 'Indigenous + digital',
      programsIntro:
        'Ang Indigitous ay pandaigdigang network ng mga tagasunod ni Hesus na tumutuklas ng kanilang lugar sa misyon ng Diyos. Ganito namin ito ginagawa sa Pilipinas.',
      programs: [
        {
          icon: 'code',
          title: '#HACK Philippines',
          body: 'Tuwing Oktubre, bumubuo ang mga team sa buong bansa ng praktikal na solusyon para punan ang mga puwang sa misyon.',
          href: '/hack',
          cta: 'Tungkol sa #HACK',
        },
        {
          icon: 'users',
          title: 'Mga lokal na komunidad',
          body: 'Regular na meetup sa Manila at Iloilo para sa mga tech at creative na tao para matuto, bumuo at manalangin.',
          href: '/communities',
          cta: 'Maghanap ng komunidad',
        },
        {
          icon: 'sparkles',
          title: 'Mga proyekto',
          body: 'Mga app, website at content na gawa ng Pilipino, para sa Pilipino, at para sa simbahan.',
          href: '/projects',
          cta: 'Tingnan ang mga proyekto',
        },
      ],
      eventsEyebrow: 'Mga event',
      eventsTitle: 'Mga paparating',
      statsCaption: 'Pandaigdigang bilang ng #HACK mula 2016, mula sa hack.indigitous.org.',
      stats: [
        { value: '10,154', label: 'taong sumali sa #HACK' },
        { value: '174', label: 'lungsod sa buong mundo' },
        { value: '63', label: 'bansa' },
        { value: '2', label: 'komunidad sa Pilipinas' },
      ],
      needEyebrow: 'Bakit ito mahalaga',
      needTitle: 'Ngayon, 3 bilyong tao ang hindi pa kilala si Hesus',
      needBody:
        'Marami sa kanila ay online, gayundin ang mahigit 85 milyong Pilipino. Ang digital na mundo ay isang mission field, at may lugar ka rito.',
      needCta: 'Tungkol sa Indigitous',
      communityEyebrow: 'Ang aming komunidad',
      communityTitle: 'Hanapin ang iyong mga kasama',
      startCommunity: 'Magsimula ng komunidad',
      tribeTitle: 'Creative ka ba o developer?',
      tribeBody:
        'Dito mo makikita ang iyong tribo. Gamitin ang iyong galing para maglingkod sa simbahan at abutin ang mga tao ng ebanghelyo.',
      tribeCta: 'Makibahagi',
      storiesEyebrow: 'Mga kuwento',
      storiesTitle: 'Pinakabago mula sa Indigitous PH',
    },
  },
  lang,
);

const events = (await getLocalized('events', lang)).sort(byDateAsc);
const upcoming = events.filter((e) => isUpcoming(e.data.date));
const shownEvents = (upcoming.length ? upcoming : events.slice().reverse()).slice(0, 3);
const communities = (await getLocalized('communities', lang)).sort(byOrder);
const stories = (await getLocalized('stories', lang)).sort(byDateDesc).slice(0, 3);
const programs = copy.programs.map((p) => ({ ...p, href: L(p.href) })) as FeatureItem[];
---

<BaseLayout {lang}>
  <Hero eyebrow={copy.eyebrow} title={copy.title} highlight={copy.highlight} intro={copy.intro}>
    <Fragment slot="actions">
      <Button href={L('/start-here')} size="lg" icon="arrow-right">
        {t('nav.startHere')}
      </Button>
      <Button href={L('/hack')} size="lg" variant="light">
        {copy.hackCta}
      </Button>
    </Fragment>
  </Hero>

  <Section>
    <SectionHeading
      eyebrow={copy.programsEyebrow}
      title={copy.programsTitle}
      intro={copy.programsIntro}
    />
    <FeatureGrid items={programs} />
  </Section>

  <Section tone="mist">
    <SectionHeading eyebrow={copy.eventsEyebrow} title={copy.eventsTitle}>
      <Button href={L('/events')} variant="outline" icon="arrow-right">
        {t('cta.viewAll')}
      </Button>
    </SectionHeading>
    <CardGrid>
      {shownEvents.map((e) => (
        <EventCard
          title={e.data.title}
          href={L(`/events/${e.slug}`)}
          date={e.data.date}
          location={e.data.location}
          summary={e.data.summary}
          image={e.data.image}
          online={e.data.online}
          placeholder={e.data.placeholder}
          lang={htmlLang[lang]}
          labels={{
            event: t('label.event'),
            online: t('events.online'),
            placeholder: t('label.placeholder'),
          }}
        />
      ))}
    </CardGrid>
  </Section>

  <Section>
    <StatsBand stats={copy.stats} caption={copy.statsCaption} />
    <CtaBand eyebrow={copy.needEyebrow} title={copy.needTitle} body={copy.needBody} class="mt-8">
      <Button href={L('/about')} variant="dark" icon="arrow-right">
        {copy.needCta}
      </Button>
    </CtaBand>
  </Section>

  <Section>
    <SectionHeading eyebrow={copy.communityEyebrow} title={copy.communityTitle}>
      <Button href={L('/communities')} variant="outline" icon="arrow-right">
        {t('nav.communities')}
      </Button>
    </SectionHeading>
    <CardGrid cols={3}>
      {communities.map((c) => (
        <CommunityCard
          name={c.data.name}
          region={c.data.region}
          summary={c.data.summary}
          image={c.data.image}
          href={L(`/communities/${c.slug}`)}
        />
      ))}
      <a
        href={L('/contact')}
        class="flex aspect-[4/5] flex-col items-center justify-center gap-3 rounded-card border-2 border-dashed border-stone p-6 text-center font-mono font-medium text-ink-2 transition hover:border-brand-orange hover:text-brand-orange-dark"
      >
        <span class="text-4xl" aria-hidden="true">
          +
        </span>
        {copy.startCommunity}
      </a>
    </CardGrid>
  </Section>

  <Section class="pt-0!">
    <CtaBand tone="ink" title={copy.tribeTitle} body={copy.tribeBody}>
      <Button href={L('/get-involved')} variant="light" icon="arrow-right">
        {copy.tribeCta}
      </Button>
    </CtaBand>
  </Section>

  <Section tone="mist">
    <SectionHeading eyebrow={copy.storiesEyebrow} title={copy.storiesTitle}>
      <Button href={L('/stories')} variant="outline" icon="arrow-right">
        {t('cta.viewAll')}
      </Button>
    </SectionHeading>
    <CardGrid>
      {stories.map((s) => (
        <StoryCard
          title={s.data.title}
          href={L(`/stories/${s.slug}`)}
          date={s.data.date}
          summary={s.data.summary}
          category={s.data.tags[0]}
          image={s.data.image}
          readMore={t('cta.readMore')}
          placeholder={s.data.placeholder}
          placeholderLabel={t('label.placeholder')}
          lang={htmlLang[lang]}
        />
      ))}
    </CardGrid>
  </Section>

  <Section>
    <NewsletterBand
      title={t('newsletter.title')}
      body={t('newsletter.body')}
      altLabel={t('newsletter.alt')}
      labels={{
        firstName: t('form.firstName'),
        email: t('form.email'),
        subscribe: t('cta.subscribe'),
      }}
    />
  </Section>
</BaseLayout>
