---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import FeatureGrid, { type FeatureItem } from '@/components/sections/FeatureGrid.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Button from '@/components/ui/Button.astro';
import { localizePath, pick, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const copy = pick(
  {
    en: {
      title: 'Discover your place in God’s mission',
      intro:
        'There is a great need, and you can be part of the solution. Pick the path that sounds most like you.',
      pathsEyebrow: 'Choose your path',
      pathsTitle: 'I am a…',
      paths: [
        {
          icon: 'code',
          title: 'Developer',
          body: 'Build apps, sites and tools for churches and ministries. Join a #HACK team or a project.',
          href: '/projects',
          cta: 'See projects',
        },
        {
          icon: 'palette',
          title: 'Designer',
          body: 'UX, graphics, branding. Help ministries look and work as good as the message they carry.',
          href: '/get-involved',
          cta: 'Volunteer',
        },
        {
          icon: 'video',
          title: 'Content creator',
          body: 'Writers, photographers and videographers telling stories that point to Jesus.',
          href: '/stories',
          cta: 'Read stories',
        },
        {
          icon: 'gamepad',
          title: 'Gamer',
          body: 'Games and gaming communities are a mission field too. Come play and build with us.',
          href: '/events',
          cta: 'Find an event',
        },
        {
          icon: 'church',
          title: 'Ministry leader',
          body: 'Bring a challenge your church or ministry faces and let tech and creative people help.',
          href: '/hack',
          cta: 'Submit a challenge',
        },
        {
          icon: 'heart',
          title: 'Just curious',
          body: 'Not sure yet? Come to a meetup, meet the community and pray with us.',
          href: '/communities',
          cta: 'Find a community',
        },
      ],
      stepsEyebrow: 'Next steps',
      stepsTitle: 'Three easy ways to start',
      steps: [
        {
          n: '01',
          title: 'Come to an event',
          body: 'Coffee talks, meetups and #HACK are the easiest way in.',
        },
        {
          n: '02',
          title: 'Join a community',
          body: 'Connect with Indigitous people near you, or online.',
        },
        {
          n: '03',
          title: 'Build something',
          body: 'Use your skills on a real project that serves real people.',
        },
      ],
      ctaTitle: 'Still not sure where to begin?',
      ctaBody: 'Send us a message and we will help you find your place.',
    },
    fil: {
      title: 'Tuklasin ang iyong lugar sa misyon ng Diyos',
      intro:
        'Malaki ang pangangailangan, at maaari kang maging bahagi ng solusyon. Piliin ang landas na pinaka-bagay sa iyo.',
      pathsEyebrow: 'Piliin ang iyong landas',
      pathsTitle: 'Ako ay isang…',
      paths: [
        {
          icon: 'code',
          title: 'Developer',
          body: 'Bumuo ng mga app, site at tool para sa mga simbahan at ministeryo. Sumali sa #HACK team o proyekto.',
          href: '/projects',
          cta: 'Tingnan ang mga proyekto',
        },
        {
          icon: 'palette',
          title: 'Designer',
          body: 'UX, graphics, branding. Tulungan ang mga ministeryo na maging kasing-ganda ng mensaheng dala nila.',
          href: '/get-involved',
          cta: 'Mag-volunteer',
        },
        {
          icon: 'video',
          title: 'Content creator',
          body: 'Mga manunulat, photographer at videographer na nagkukuwento na tumuturo kay Hesus.',
          href: '/stories',
          cta: 'Basahin ang mga kuwento',
        },
        {
          icon: 'gamepad',
          title: 'Gamer',
          body: 'Mission field din ang mga laro at gaming community. Maglaro at bumuo kasama namin.',
          href: '/events',
          cta: 'Maghanap ng event',
        },
        {
          icon: 'church',
          title: 'Lider ng ministeryo',
          body: 'Magdala ng hamong kinakaharap ng inyong simbahan at hayaang tumulong ang mga tech at creative.',
          href: '/hack',
          cta: 'Magsumite ng hamon',
        },
        {
          icon: 'heart',
          title: 'Curious lang',
          body: 'Hindi pa sigurado? Pumunta sa meetup, kilalanin ang komunidad at manalangin kasama namin.',
          href: '/communities',
          cta: 'Maghanap ng komunidad',
        },
      ],
      stepsEyebrow: 'Mga susunod na hakbang',
      stepsTitle: 'Tatlong madaling paraan para magsimula',
      steps: [
        {
          n: '01',
          title: 'Pumunta sa event',
          body: 'Coffee talk, meetup at #HACK ang pinakamadaling simula.',
        },
        {
          n: '02',
          title: 'Sumali sa komunidad',
          body: 'Kumonekta sa mga taga-Indigitous na malapit sa iyo, o online.',
        },
        {
          n: '03',
          title: 'Bumuo ng isang bagay',
          body: 'Gamitin ang iyong galing sa totoong proyekto para sa totoong tao.',
        },
      ],
      ctaTitle: 'Hindi pa rin sigurado kung saan magsisimula?',
      ctaBody: 'Mag-message sa amin at tutulungan ka naming mahanap ang iyong lugar.',
    },
  },
  lang,
);
const paths = copy.paths.map((p) => ({ ...p, href: L(p.href) })) as FeatureItem[];
---

<BaseLayout {lang} title={t('nav.startHere')} description={copy.intro}>
  <PageHeader tone="ink" eyebrow={t('nav.startHere')} title={copy.title} intro={copy.intro} />
  <Section>
    <SectionHeading eyebrow={copy.pathsEyebrow} title={copy.pathsTitle} />
    <FeatureGrid items={paths} />
  </Section>
  <Section tone="mist">
    <SectionHeading eyebrow={copy.stepsEyebrow} title={copy.stepsTitle} />
    <ol class="grid gap-6 md:grid-cols-3">
      {copy.steps.map((s) => (
        <li class="flex flex-col gap-3 rounded-card bg-white p-8">
          <span class="font-mono text-4xl font-bold text-brand-orange-dark">{s.n}</span>
          <h3 class="text-xl">{s.title}</h3>
          <p class="text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </Section>
  <Section>
    <CtaBand title={copy.ctaTitle} body={copy.ctaBody}>
      <Button href={L('/contact')} variant="dark" icon="arrow-right">
        {t('nav.contact')}
      </Button>
    </CtaBand>
  </Section>
</BaseLayout>
