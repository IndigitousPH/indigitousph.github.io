---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import FeatureGrid, { type FeatureItem } from '@/components/sections/FeatureGrid.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { pick, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = pick(
  {
    en: {
      title: 'Fuel digital mission in the Philippines',
      intro: 'Your gift helps Filipino followers of Jesus use their skills to reach their world.',
      whereTitle: 'Where your gift goes',
      where: [
        {
          icon: 'sparkles',
          title: '#HACK events',
          body: 'Venues, food and tools for hackathons across the country.',
        },
        {
          icon: 'users',
          title: 'Communities',
          body: 'Meetups, training and resources for local leaders.',
        },
        {
          icon: 'code',
          title: 'Projects',
          body: 'Hosting, licenses and support to keep good projects running.',
        },
      ],
      howTitle: 'How to give',
      how: 'Gifts to Indigitous are processed securely by Cru through the official Indigitous giving page. Choose the fund and currency that fits you.',
      giveCta: 'Give on indigitous.org',
      note: 'Indigitous Philippines does not collect payments on this website.',
    },
    fil: {
      title: 'Pondohan ang digital na misyon sa Pilipinas',
      intro:
        'Tumutulong ang iyong kaloob sa mga Pilipinong tagasunod ni Hesus na gamitin ang kanilang galing para abutin ang kanilang mundo.',
      whereTitle: 'Saan napupunta ang iyong kaloob',
      where: [
        {
          icon: 'sparkles',
          title: 'Mga #HACK event',
          body: 'Venue, pagkain at tool para sa mga hackathon sa buong bansa.',
        },
        {
          icon: 'users',
          title: 'Mga komunidad',
          body: 'Meetup, training at resource para sa mga lokal na lider.',
        },
        {
          icon: 'code',
          title: 'Mga proyekto',
          body: 'Hosting, lisensya at suporta para magpatuloy ang mabubuting proyekto.',
        },
      ],
      howTitle: 'Paano magbigay',
      how: 'Ligtas na pinoproseso ng Cru ang mga kaloob sa Indigitous sa opisyal na giving page ng Indigitous. Piliin ang pondo at currency na bagay sa iyo.',
      giveCta: 'Magbigay sa indigitous.org',
      note: 'Hindi tumatanggap ng bayad ang Indigitous Philippines sa website na ito.',
    },
  },
  lang,
);
---

<BaseLayout {lang} title={t('nav.give')} description={copy.intro}>
  <PageHeader tone="gradient" eyebrow={t('nav.give')} title={copy.title} intro={copy.intro} />
  <Section>
    <SectionHeading title={copy.whereTitle} />
    <FeatureGrid items={copy.where as FeatureItem[]} />
  </Section>
  <Section tone="mist">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-6 text-center">
      <h2 class="text-3xl md:text-4xl">{copy.howTitle}</h2>
      <p class="text-lg text-ink-2">{copy.how}</p>
      <Button href={site.global.give} size="lg" external icon="arrow-up-right">
        {copy.giveCta}
      </Button>
      <p class="font-mono text-sm text-muted">{copy.note}</p>
    </div>
  </Section>
</BaseLayout>
