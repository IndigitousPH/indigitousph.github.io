---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/sections/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PillTag from '@/components/ui/PillTag.astro';
import { render } from 'astro:content';
import { formatDate, localizePath, useTranslations, type Lang } from '@/i18n';
import type { Localized } from '@/lib/content';

interface Props {
  lang: Lang;
  entry: Localized<'events'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
const time = (date: Date) =>
  date.toLocaleTimeString(lang === 'fil' ? 'fil-PH' : 'en-PH', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'Asia/Manila',
  });
---

<BaseLayout {lang} title={d.title} description={d.summary}>
  <header class="bg-ink text-white">
    <div class="container-page flex flex-col gap-6 py-16 md:py-20">
      <a
        href={localizePath('/events', lang)}
        class="inline-flex w-max items-center gap-2 font-mono text-sm text-white/75 hover:text-brand-yellow"
      >
        <Icon name="arrow-left" size={16} />
        {t('nav.events')}
      </a>
      <div class="flex flex-wrap gap-2">
        <PillTag size="sm">{t('label.event')}</PillTag>
        {d.online && (
          <PillTag size="sm" tone="mist">
            {t('events.online')}
          </PillTag>
        )}
        {d.placeholder && (
          <PillTag size="sm" tone="outline" class="border-white/40 text-white">
            {t('label.placeholder')}
          </PillTag>
        )}
      </div>
      <h1 class="max-w-4xl text-4xl leading-tight md:text-5xl">{d.title}</h1>
      <p class="max-w-2xl text-lg text-white/85">{d.summary}</p>
      <dl class="flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
        <div class="flex items-center gap-2">
          <dt>
            <Icon name="calendar" size={18} label="Date" />
          </dt>
          <dd>
            {formatDate(d.date, lang, { weekday: 'short', month: 'long' })} · {time(d.date)}
            {d.endDate && <> – {formatDate(d.endDate, lang, { month: 'long' })}</>}
          </dd>
        </div>
        <div class="flex items-center gap-2">
          <dt>
            <Icon name="map-pin" size={18} label="Location" />
          </dt>
          <dd>{d.location}</dd>
        </div>
      </dl>
      {d.registerUrl && (
        <Button href={d.registerUrl} external icon="arrow-up-right" class="w-max">
          {t('events.register')}
        </Button>
      )}
    </div>
  </header>
  <Section>
    <div class="prose-indigitous">
      <Content />
    </div>
  </Section>
</BaseLayout>
