---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import CardGrid from '@/components/sections/CardGrid.astro';
import StoryCard from '@/components/cards/StoryCard.astro';
import SwitchTabs from '@/components/ui/SwitchTabs.astro';
import { htmlLang, localizePath, pick, useTranslations, type Lang } from '@/i18n';
import { byDateDesc, getLocalized } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = pick(
  {
    en: {
      title: 'Stories',
      intro: 'News, recaps, testimonies and how-tos from Indigitous Philippines.',
    },
    fil: {
      title: 'Mga kuwento',
      intro: 'Balita, recap, patotoo at how-to mula sa Indigitous Philippines.',
    },
  },
  lang,
);
const stories = (await getLocalized('stories', lang)).sort(byDateDesc);
const tags = [...new Set(stories.flatMap((s) => s.data.tags))].sort();
---

<BaseLayout {lang} title={t('nav.stories')} description={copy.intro}>
  <PageHeader eyebrow={t('nav.stories')} title={copy.title} intro={copy.intro} />
  <Section>
    <SwitchTabs
      filterGroup="stories"
      active="all"
      label={t('nav.stories')}
      class="mb-10"
      items={[
        { label: t('filter.all'), value: 'all' },
        ...tags.map((tag) => ({ label: `#${tag}`, value: tag })),
      ]}
    />
    <CardGrid>
      {stories.map((s) => (
        <div data-filter-group="stories" data-filter-tags={s.data.tags.join(' ')}>
          <StoryCard
            title={s.data.title}
            href={localizePath(`/stories/${s.slug}`, lang)}
            date={s.data.date}
            summary={s.data.summary}
            category={s.data.tags[0]}
            image={s.data.image}
            readMore={t('cta.readMore')}
            placeholder={s.data.placeholder}
            placeholderLabel={t('label.placeholder')}
            lang={htmlLang[lang]}
          />
        </div>
      ))}
    </CardGrid>
  </Section>
</BaseLayout>
