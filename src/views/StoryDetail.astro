---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/sections/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import PillTag from '@/components/ui/PillTag.astro';
import { render } from 'astro:content';
import { formatDate, localizePath, useTranslations, type Lang } from '@/i18n';
import type { Localized } from '@/lib/content';

interface Props {
  lang: Lang;
  entry: Localized<'stories'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout {lang} title={d.title} description={d.summary} image={d.image}>
  <article>
    <header class="bg-mist">
      <div class="container-page flex flex-col gap-5 py-16 md:py-20">
        <a
          href={localizePath('/stories', lang)}
          class="inline-flex w-max items-center gap-2 font-mono text-sm text-muted hover:text-brand-orange-dark"
        >
          <Icon name="arrow-left" size={16} />
          {t('nav.stories')}
        </a>
        <div class="flex flex-wrap gap-2">
          {d.tags.map((tag) => (
            <PillTag size="sm">#{tag}</PillTag>
          ))}
          {d.placeholder && (
            <PillTag tone="outline" size="sm">
              {t('label.placeholder')}
            </PillTag>
          )}
        </div>
        <h1 class="max-w-4xl text-4xl md:text-5xl">{d.title}</h1>
        <p class="max-w-2xl text-lg text-ink-2">{d.summary}</p>
        <p class="font-mono text-sm text-muted">
          {t('label.by')} {d.author} ·{' '}
          <time datetime={d.date.toISOString()}>{formatDate(d.date, lang, { month: 'long' })}</time>
        </p>
      </div>
    </header>
    {d.image && (
      <div class="container-page -mb-8 pt-10">
        <img src={d.image} alt="" class="aspect-[2/1] w-full rounded-card object-cover" />
      </div>
    )}
    <Section>
      <div class="prose-indigitous mx-auto">
        <Content />
      </div>
    </Section>
  </article>
</BaseLayout>
