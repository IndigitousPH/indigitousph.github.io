---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Section from '@/components/sections/Section.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { pick, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

type Link = { title: string; body: string; href: string };
const copy = pick(
  {
    en: {
      title: 'Tools for digital mission',
      intro:
        'Apps, guides and research we love, curated for Filipino churches, ministries and creators.',
      groups: [
        {
          title: 'Apps & tools',
          links: [
            {
              title: 'GodTools',
              body: 'Free tools to start gospel conversations, available in many languages.',
              href: 'https://godtoolsapp.com',
            },
            {
              title: 'Jesus Film Project',
              body: 'The JESUS film and other videos in hundreds of languages, including Tagalog and Cebuano.',
              href: 'https://www.jesusfilm.org',
            },
            {
              title: 'Indigitous Learn: Apps & tools',
              body: 'Articles on digital tools for mission from the global network.',
              href: 'https://indigitous.org/topic/apps-tools/',
            },
          ],
        },
        {
          title: 'Learn',
          links: [
            {
              title: 'Indigitous Learn',
              body: 'Guides on platforms, apps and mission strategy.',
              href: site.global.learn,
            },
            {
              title: 'Platforms: Facebook, Instagram, TikTok',
              body: 'How ministries use the platforms Filipinos use most.',
              href: 'https://indigitous.org/topic/platforms/',
            },
            {
              title: 'For missions',
              body: 'Hackathons, apps and digital marketing for ministry.',
              href: 'https://indigitous.org/topic/for-missions/',
            },
          ],
        },
        {
          title: 'Research',
          links: [
            {
              title: 'Indigitous reports',
              body: 'Including the State of Digital Technologies report.',
              href: site.global.reports,
            },
            {
              title: 'Who are frontier people groups?',
              body: 'An illustrated prayer toolkit covering 31 people groups.',
              href: site.global.frontierPeopleGroups,
            },
            {
              title: '#HACK impact reports',
              body: 'What #HACK teams have built around the world.',
              href: site.global.hack,
            },
          ],
        },
      ] as { title: string; links: Link[] }[],
    },
    fil: {
      title: 'Mga gamit para sa digital na misyon',
      intro:
        'Mga app, gabay at research na gusto namin, pinili para sa mga simbahan, ministeryo at creator na Pilipino.',
      groups: [
        {
          title: 'Mga app at tool',
          links: [
            {
              title: 'GodTools',
              body: 'Libreng tool para magsimula ng usapan tungkol sa ebanghelyo, sa maraming wika.',
              href: 'https://godtoolsapp.com',
            },
            {
              title: 'Jesus Film Project',
              body: 'Ang pelikulang JESUS at iba pang video sa daan-daang wika, kasama ang Tagalog at Cebuano.',
              href: 'https://www.jesusfilm.org',
            },
            {
              title: 'Indigitous Learn: Apps & tools',
              body: 'Mga artikulo tungkol sa digital na tool para sa misyon.',
              href: 'https://indigitous.org/topic/apps-tools/',
            },
          ],
        },
        {
          title: 'Matuto',
          links: [
            {
              title: 'Indigitous Learn',
              body: 'Mga gabay sa platform, app at estratehiya ng misyon.',
              href: site.global.learn,
            },
            {
              title: 'Platforms: Facebook, Instagram, TikTok',
              body: 'Paano ginagamit ng mga ministeryo ang mga platform na pinakaginagamit ng Pilipino.',
              href: 'https://indigitous.org/topic/platforms/',
            },
            {
              title: 'Para sa misyon',
              body: 'Hackathon, app at digital marketing para sa ministeryo.',
              href: 'https://indigitous.org/topic/for-missions/',
            },
          ],
        },
        {
          title: 'Research',
          links: [
            {
              title: 'Mga ulat ng Indigitous',
              body: 'Kasama ang State of Digital Technologies report.',
              href: site.global.reports,
            },
            {
              title: 'Sino ang mga frontier people group?',
              body: 'Isang illustrated na prayer toolkit para sa 31 people group.',
              href: site.global.frontierPeopleGroups,
            },
            {
              title: 'Mga ulat ng #HACK',
              body: 'Ang mga nabuo ng mga #HACK team sa buong mundo.',
              href: site.global.hack,
            },
          ],
        },
      ] as { title: string; links: Link[] }[],
    },
  },
  lang,
);
---

<BaseLayout {lang} title={t('nav.resources')} description={copy.intro}>
  <PageHeader eyebrow={t('nav.resources')} title={copy.title} intro={copy.intro} />
  {copy.groups.map((group, i) => (
    <Section tone={i % 2 ? 'mist' : 'white'}>
      <SectionHeading title={group.title} />
      <ul class="grid gap-4 md:grid-cols-3">
        {group.links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col gap-3 rounded-card bg-white p-7 ring-1 ring-stone transition hover:ring-2 hover:ring-brand-orange"
            >
              <span class="flex items-start justify-between gap-4 text-xl font-bold">
                {link.title}
                <Icon
                  name="arrow-up-right"
                  class="text-brand-orange-dark transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </span>
              <span class="text-muted">{link.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  ))}
</BaseLayout>
