---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('404.title')} noindex>
  <section class="container-page flex flex-col items-center gap-6 py-28 text-center">
    <p class="font-mono text-8xl font-bold text-brand-orange-dark md:text-9xl">404</p>
    <h1 class="text-3xl md:text-4xl">{t('404.title')}</h1>
    <p class="max-w-md text-lg text-muted">{t('404.body')}</p>
    <Button href="/" icon="arrow-right">
      {t('404.home')}
    </Button>
  </section>
</BaseLayout>
