---
import StoryDetail from '@/views/StoryDetail.astro';
import { getLocalized } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getLocalized('stories', 'en');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<StoryDetail lang="en" {entry} />
