---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/sections/Section.astro';
import EventDetails from '@/components/sections/EventDetails.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PillTag from '@/components/ui/PillTag.astro';
import { render } from 'astro:content';
import { formatRange, t } from '@/i18n';
import { getAll, type Entry } from '@/lib/content';

export async function getStaticPaths() {
  return (await getAll('events')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Entry<'events'> };
const { Content } = await render(entry);
const d = entry.data;
const end = d.endDate.toISOString();
---

<BaseLayout title={d.title} description={d.summary} image={d.image}>
  <header class="bg-ink text-white">
    <div class="container-page flex flex-col gap-6 py-16 md:py-20">
      <a
        href="/events"
        class="inline-flex w-max items-center gap-2 font-mono text-sm text-white/75 hover:text-brand-yellow"
      >
        <Icon name="arrow-left" size={16} />
        Events
      </a>
      <div class="flex flex-wrap gap-2">
        <PillTag size="sm">{t('label.event')}</PillTag>
        {d.online && (
          <PillTag size="sm" tone="mist">
            {t('events.online')}
          </PillTag>
        )}
        {d.placeholder && (
          <PillTag size="sm" tone="outline" class="border-white/40 text-white">
            {t('label.placeholder')}
          </PillTag>
        )}
      </div>
      <h1 class="max-w-4xl text-4xl leading-tight md:text-5xl">{d.title}</h1>
      <p class="max-w-2xl text-lg text-white/85">{d.summary}</p>
      {d.registerUrl && (
        <Button
          href={d.registerUrl}
          external
          icon="arrow-up-right"
          class="self-start max-w-full"
          data-hide-after={end}
        >
          {d.registerLabel ?? t('events.register')}
        </Button>
      )}
    </div>
  </header>
  <Section>
    <EventDetails
      rows={[
        { label: 'When', value: formatRange(d.date, d.endDate), icon: 'calendar' },
        { label: 'Where', value: d.venue, icon: 'map-pin' },
        ...(d.fee ? [{ label: 'Fee', value: d.fee, icon: 'ticket' as const }] : []),
        ...(d.who ? [{ label: 'Who', value: d.who, icon: 'users' as const }] : []),
        ...(d.bring ? [{ label: 'Bring', value: d.bring, icon: 'backpack' as const }] : []),
      ]}
      mapEmbed={d.mapEmbed}
      mapTitle={`Map to ${d.venue}`}
    />
    <div class="prose-indigitous mt-12">
      <Content />
    </div>
  </Section>
</BaseLayout>
