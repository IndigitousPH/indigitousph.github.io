---
import CommunityDetail from '@/views/CommunityDetail.astro';
import { getLocalized } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getLocalized('communities', 'en');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<CommunityDetail lang="en" {entry} />
