---
/** About: what is Indigitous, why it exists in the Philippines, and who is behind it. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Section from '@/components/sections/Section.astro';
import SplitText from '@/components/sections/SplitText.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Beliefs from '@/components/sections/Beliefs.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import GlobalBand from '@/components/sections/GlobalBand.astro';
import CTABand from '@/components/sections/CTABand.astro';
import TeamCard from '@/components/cards/TeamCard.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { byOrder, getAll } from '@/lib/content';

const copy = {
  hero: {
    title: 'Locally rooted. Digitally sent.',
    intro:
      'Indigitous Philippines is part of a global movement helping believers use their gifts for missions in a digital age.',
  },
  name: {
    parts: [
      {
        word: 'Indigenous',
        text: 'Locally rooted. The gospel shared by Filipinos, in our languages and our culture.',
      },
      {
        word: 'Digital',
        text: 'Where people gather. The apps, platforms and online spaces where our friends spend their days.',
      },
    ] as [{ word: string; text: string }, { word: string; text: string }],
    footnote:
      'Put them together and you get Indigitous: local believers reaching their own people in our world in the digital space.',
  },
  story: {
    title: 'Our story',
    // Deck draft said "began in 2016"; indigitous.org dates the movement to 2013 and #HACK to 2016.
    intro:
      'Indigitous began in 2013 as a global movement, and its first #HACK in 2016 gathered believers in cities around the world. Filipino believers soon joined in.',
    // TODO(content): add the year Indigitous PH started and the year the online workers ministry and prayer time began.
    milestones: [
      {
        year: '2013',
        text: 'Indigitous begins as a global movement of believers using their gifts for missions in a digital age.',
      },
      { year: '2016', text: 'The first #HACK gathers believers in cities around the world.' },
      { year: '2019', text: '#HACK comes to Iloilo.' },
      { year: '2026', text: '#HACK for Christmas in Iloilo.' },
    ],
  },
  beliefs: [
    { title: 'Jesus is worth knowing.', body: 'Everything we do points people to Him.' },
    {
      title: 'Every believer is sent.',
      body: 'Your gifts and your online world are part of your calling.',
    },
    {
      title: 'We go further together.',
      body: 'We partner with churches and ministries; we don’t compete with them.',
    },
  ],
  team: { title: 'The people behind Indigitous Philippines' },
  global: {
    text: 'We’re one local expression of Indigitous, a global movement of believers in many countries.',
    linkText: 'Visit Indigitous global',
  },
  closing: { title: 'Want to meet us?', body: 'Join a local network or send us a message.' },
};

const team = (await getAll('team')).sort(byOrder);
---

<BaseLayout title="About" description={copy.hero.intro}>
  <PageHero eyebrow="About" title={copy.hero.title} intro={copy.hero.intro} />

  <Section>
    <SplitText
      variant="name"
      title="The name"
      parts={copy.name.parts}
      footnote={copy.name.footnote}
    />
  </Section>

  <Section tone="mist">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <h2 class="text-3xl md:text-4xl">{copy.story.title}</h2>
      <Timeline intro={copy.story.intro} items={copy.story.milestones} />
    </div>
  </Section>

  <Section>
    <Beliefs
      title="What we believe"
      items={copy.beliefs}
      linkText="Read our full statement of faith"
      href={site.global.statementOfFaith}
    />
  </Section>

  <Section tone="mist" id="team">
    <SectionHeading title={copy.team.title} />
    <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((m) => (
        <li>
          <TeamCard
            name={m.data.name}
            role={m.data.role}
            serveBecause={m.data.serveBecause}
            photo={m.data.photo}
            placeholder={m.data.placeholder}
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <GlobalBand text={copy.global.text} linkText={copy.global.linkText} href={site.global.home} />
    <CTABand tone="yellow" title={copy.closing.title} body={copy.closing.body} class="mt-8">
      <Button href="/networks" variant="dark">
        Find a network
      </Button>
      <Button href="/contact" variant="outline">
        Contact us
      </Button>
    </CTABand>
  </Section>
</BaseLayout>
